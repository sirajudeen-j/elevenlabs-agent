# --- Local development (defaults: SQLite file ./novamart.db, no config needed) ---
# SQLITE_PATH=./novamart.db

# --- Deployed: Turso (libSQL over HTTP) ---
# Create a db:  turso db create novamart
# Get the URL:  turso db show novamart --url
# Get a token:  turso db tokens create novamart
TURSO_DATABASE_URL=libsql://novamart-<your-org>.turso.io
TURSO_AUTH_TOKEN=<your-turso-auth-token>
